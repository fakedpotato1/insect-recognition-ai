# This is an example .env file for the backend. Copy this file to .env and fill in the values as needed.
USE_MOCK_MODEL=true # Set to true to use a mock model for testing. Set to false to use the actual model.
PORT=5000 # The port the backend server will run on. You can change this if you want to run it on a different port.
MODEL_ARTIFACT_PATH=../models/insect_classifier.npz # Saved model artifact produced from features.csv.
LOCALIZATION_MODE=auto # auto uses OpenCV contour crop; full skips localization for pre-cropped insect images.
LOCALIZATION_MIN_AREA_RATIO=0.002 # Minimum crop candidate area ratio for auto localization.
