# This is an example .env file for the backend. Copy this file to .env and fill in the values as needed.
USE_MOCK_MODEL=false # Set to true to use a mock model for UI-only testing.
PORT=5000 # The port the backend server will run on.
MODEL_ARTIFACT_PATH=../ai/model/dinov2_bp_classifier.npz # Saved BP artifact.
MODEL_FEATURE_EXTRACTOR=dinov2 # dinov2 uses the new 384-dim features; classic uses the old hand-crafted features.
DINOV2_MODEL=facebook/dinov2-small # Frozen feature extractor used before BP classification.
DINOV2_DEVICE=auto # auto, cpu, or cuda.
LOCALIZATION_MODE=auto # auto uses OpenCV contour crop; full skips localization for pre-cropped insect images.
LOCALIZATION_MIN_AREA_RATIO=0.002 # Minimum crop candidate area ratio for auto localization.
